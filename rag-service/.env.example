SERVER_PORT=8081
RAG_DATABASE_URL=jdbc:postgresql://localhost:5433/gota_rag
RAG_DATABASE_USERNAME=gota_rag
RAG_DATABASE_PASSWORD=change-me
APP_CORS_ALLOWED_ORIGIN=http://localhost:3000

# Never commit a real key. Create one in Google AI Studio and set it only in
# your local shell, IDE run configuration, or an ignored .env file.
GEMINI_API_KEY=replace-with-your-local-key
GEMINI_MODEL=gemini-3.8-flash
